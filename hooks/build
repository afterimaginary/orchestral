#!/bin/sh
# Builds the binary for a copy of the plugin installed from a marketplace,
# which arrives as source only. Cargo's target directory lives in the
# plugin's data folder, so it survives updates and rebuilds incrementally;
# the binary is copied to where bin/orchestral looks for it.
root="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "$root/target/release/orchestral" ] || [ -x "$root/target/debug/orchestral" ]; then
  exit 0
fi
data="${CLAUDE_PLUGIN_DATA:-$root}"
mkdir -p "$data"
log="$data/build.log"
# A hook may start with a short PATH, so fall back to the usual installs.
PATH="$PATH:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin"
if CARGO_TARGET_DIR="$data/target" cargo build --release --locked \
  --manifest-path "$root/Cargo.toml" >"$log" 2>&1; then
  mkdir -p "$root/target/release"
  cp "$data/target/release/orchestral" "$root/target/release/orchestral.tmp.$$" &&
    mv "$root/target/release/orchestral.tmp.$$" "$root/target/release/orchestral"
else
  echo "Orchestral's binary didn't build with $(cargo --version 2>/dev/null || echo 'no cargo on PATH'), so its commands will fail. The build log is $log. Install or update Rust (edition 2024 needs 1.85 or later), then start a new session."
fi
