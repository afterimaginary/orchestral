#!/bin/sh
# Runs the binary built from this checkout, preferring a release build.
root="$(cd "$(dirname "$0")/.." && pwd)"
for build in release debug; do
  if [ -x "$root/target/$build/orchestral" ]; then
    exec "$root/target/$build/orchestral" "$@"
  fi
done
echo "error: orchestral isn't built; run \`cargo build --release\` in $root" >&2
exit 1
